PORT=8091
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/subit_website_content
DATABASE_USER=subit_website_content
DATABASE_PASSWORD=replace-with-a-long-random-password
BIND_HOST=127.0.0.1

CONTENT_PUBLIC_DIR=/var/lib/subit-website-content/public
BOOTSTRAP_CONTENT_FILE=/opt/subit-website-content/site-content.json
PUBLIC_ORIGIN=https://subit.org.cn

SSO_FRONTEND_URL=https://ssubito.subit.org.cn
SSO_API_URL=https://sso.subit.org.cn/api
SSO_SERVICE_ID=replace-with-service-id
SSO_SERVICE_TOKEN=replace-with-service-token
SESSION_SECRET=replace-with-at-least-32-random-bytes

COOKIE_SECURE=true
BOOTSTRAP_ADMIN_IDS=replace-with-first-admin-sso-user-id
MAX_UPLOAD_BYTES=8388608
